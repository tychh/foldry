{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foldry",
  "version": "0.1.2",
  "identifier": "app.foldry.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm --dir frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm --dir frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Foldry",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "devCsp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "tychh",
    "copyright": "Copyright © 2026 tychh",
    "category": "Utility",
    "shortDescription": "Safe, explainable actions for your folders",
    "longDescription": "Foldry remembers folders, applies reusable Ignore Profiles, and runs verified ZIP, TAR.GZ, and TAR.ZST Archive actions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../resources/profiles": "resources/profiles",
      "../../resources/presets": "resources/presets"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    }
  }
}
